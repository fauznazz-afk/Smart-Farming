<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Declared rather than inherited. flutter_local_notifications contributes this
      permission today, but the native alarm module must keep working if that
      plugin is ever dropped, and a notification that silently stops vibrating is
      not worth the coupling.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Only to show the system dialog that exempts the app from battery
      optimisation. Nothing is granted silently: the user is asked, and the app
      works without it, it just may be less reliable about waking up on time.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Not requested at runtime and not needed. Geolocator asks for fine or
      approximate location only, and the alarm module takes no wake lock: the
      receiver is given its window by the platform. Background location is one
      of the permissions a store review treats as sensitive, so it is not worth
      declaring for something the app never does.
    -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/energrow_launcher"
        android:roundIcon="@drawable/energrow_launcher">
        <!--
          Declared here so the release build keeps the drawable alive.

          AlarmNotificationService passes @drawable/ic_energrow to
          flutter_local_notifications, but that reference lives in a Dart string
          and is therefore invisible to the Android resource shrinker. Every
          resource reachable only from Dart was stripped, and the release build
          then failed at startup with:

            PlatformException(invalid_icon, The resource @drawable/ic_energrow
            could not be found)

          which main.dart swallowed, so alarm notifications silently never
          appeared. This line is the reference the shrinker does read. The native
          alarm module passes the same drawable to NotificationCompat, where the
          reference is in Kotlin and visible to the shrinker anyway. Verify with:

            aapt2 dump resources build/app/outputs/flutter-apk/app-release.apk \
              | grep ic_energrow
        -->
        <meta-data
            android:name="com.energrow.notification_icon"
            android:resource="@drawable/ic_energrow" />
        <!--
          Background alarm checks.

          AlarmCheckReceiver is the target of the repeating AlarmManager
          PendingIntent, so it has to be an explicit exported=false component.
          AlarmBootReceiver re-arms it, because alarms do not survive a reboot
          and a schedule that silently stops would be indistinguishable from one
          that never worked.

          This replaces android_alarm_manager_plus, which needed an <service> and
          an <receiver> declared by hand and had neither, so its alarms never
          fired at all. See AGENTS.md.
        -->
        <receiver
            android:name="tech.mbkm.energrow.alarm.AlarmCheckReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name="tech.mbkm.energrow.alarm.AlarmBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
