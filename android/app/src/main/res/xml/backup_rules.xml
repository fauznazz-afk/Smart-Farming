<?xml version="1.0" encoding="utf-8"?><!--
  Pre-Android-12 counterpart to data_extraction_rules.xml. The platform ignores
  this for D2D transfer and reads data_extraction_rules.xml instead, but
  `allowBackup="false"` plus these excludes is what stops a cloud backup on API 30
  and below.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
