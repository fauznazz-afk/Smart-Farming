/android/key.properties
/android/upload-keystore.jks
/android/*.jks

# Locally built release APKs — distribute via GitHub Releases, not the repo
/*.apk

# Widget Preview related
.widget_preview/

# graphify knowledge graph output.
#
# Rebuilt, not shared: `graphify update .` is AST-only and needs no API key, and
# graph.json alone is ~2.7 MB with another ~2.3 MB of graph.html. Committing it
# would mean every code change carries a regenerated binary blob, and two clones
# would drift. `AGENTS.md` records how to rebuild it.
graphify-out/
